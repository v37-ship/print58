<Window x:Class="WanggaSpa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WANGGA SPA — Kasir 58mm" Height="640" Width="900">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,12,0">
      <TextBlock Text="WANGGA SPA — Kasir" FontSize="18" FontWeight="Bold"/>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Pelanggan" VerticalAlignment="Center"/><TextBox x:Name="CustomerBox" Grid.Column="1" Margin="4" Text="Mama Isaac"/>
        <TextBlock Grid.Row="1" Text="Promo (HP)" VerticalAlignment="Center"/><TextBox x:Name="PromoBox" Grid.Row="1" Grid.Column="1" Margin="4" Text="08131006650"/>
        <TextBlock Grid.Row="2" Text="Pembayaran" VerticalAlignment="Center"/>
        <ComboBox x:Name="PayBox" Grid.Row="2" Grid.Column="1" Margin="4" SelectedIndex="0">
          <ComboBoxItem>LUNAS Qris</ComboBoxItem><ComboBoxItem>LUNAS Cash</ComboBoxItem><ComboBoxItem>Belum Lunas</ComboBoxItem>
        </ComboBox>
        <TextBlock Grid.Row="3" Text="Printer" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="PrinterBox" Width="220" Margin="4"/>
          <Button Content="Refresh" Click="OnRefreshPrinters" Margin="4" Padding="8,2"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="Layanan / Produk (pisahkan deskripsi dengan | )" Margin="0,8,0,2"/>
      <TextBox x:Name="ItemsBox" Height="120" AcceptsReturn="True" FontFamily="Consolas"
        Text="Massage Kids | Durasi 60 menit | 135000&#x0a;Inflaren | Durasi 30 menit | 50000&#x0a;Transport PP (HM Care) | Jarak &amp; antar jemput | 15000"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="Preview" Click="OnPreview" Padding="12,4" Margin="0,0,8,0"/>
        <Button Content="Test Print" Click="OnTestPrint" Padding="12,4" Margin="0,0,8,0"/>
        <Button Content="Print + Simpan" Click="OnPrint" Padding="12,4" FontWeight="Bold"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <GroupBox Grid.Column="1" Header="Preview 58mm (32 kolom)">
      <ScrollViewer><TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/></ScrollViewer>
    </GroupBox>
  </Grid>
</Window>
